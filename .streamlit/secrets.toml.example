# 이 파일을 복사해서 .streamlit/secrets.toml 로 이름을 바꾸거나,
# Streamlit Cloud → 앱 Settings → Secrets 칸에 아래 내용을 붙여 넣으세요.
# (secrets.toml 은 절대 GitHub에 올리지 마세요. .gitignore 에 이미 들어 있어요.)

TEACHER_PASSWORD = "여기에-교사용-비밀번호"

[firebase]
type = "service_account"
project_id = "my-climate-class"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "firebase-adminsdk-xxxxx@my-climate-class.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
